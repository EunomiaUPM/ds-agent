{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dct": "http://purl.org/dc/terms/",
    "eunomia": "https://w3id.org/eunomia/v1/",
    "Parameter": "eunomia:Parameter",
    "Secret": "eunomia:Secret",
    "Version": "eunomia:Version",
    "ApplicationConfig": "eunomia:ApplicationConfig",
    "key": "eunomia:key",
    "value": { "@id": "eunomia:value", "@type": "@json" },
    "version": { "@id": "eunomia:version", "@type": "xsd:integer" },
    "expectedVersion": { "@id": "eunomia:expectedVersion", "@type": "xsd:integer" },
    "description": "dct:description",
    "createdAt": { "@id": "dct:created", "@type": "xsd:dateTime" },
    "updatedAt": { "@id": "dct:modified", "@type": "xsd:dateTime" },
    "createdBy": "dct:creator",
    "updatedBy": "eunomia:updatedBy",
    "monolith": { "@id": "eunomia:monolith", "@type": "@json" },
    "transfer": { "@id": "eunomia:transfer", "@type": "@json" },
    "contracts": { "@id": "eunomia:contracts", "@type": "@json" },
    "catalog": { "@id": "eunomia:catalog", "@type": "@json" },
    "ssi_auth": { "@id": "eunomia:ssiAuth", "@type": "@json" },
    "gateway": { "@id": "eunomia:gateway", "@type": "@json" }
  }
}
