      "@context": {
        "@version": 1.1,
        "@protected": true
      }
    },
    "RpcNegotiationTerminationMessage": {
      "@id": "eunomia:RpcNegotiationTerminationMessage",
      "@context": {
        "@version": 1.1,
        "@protected": true,
        "code": "dspace:code",
        "reason": {
          "@id": "dspace:reason",
          "@container": "@set"
        }
      }
    },
    "RpcNegotiationResult": {
      "@id": "eunomia:RpcNegotiationResult",
      "@context": {
        "@version": 1.1,
        "@protected": true,
        "request": {
          "@id": "eunomia:request",
