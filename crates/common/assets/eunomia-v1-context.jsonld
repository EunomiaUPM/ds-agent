    "RpcCatalogRequestMessage": {
      "@id": "eunomia:RpcCatalogRequestMessage",
      "@context": {
        "@version": 1.1,
        "@protected": true,
        "associatedAgentPeer": "eunomia:associatedAgentPeer",
        "filter": {
          "@id": "dspace:filter",
          "@container": "@set"
        },
        "noCache": {
          "@id": "eunomia:noCache",
          "@type": "xsd:boolean"
        }
      }
    },
    "RpcDatasetRequestMessage": {
      "@id": "eunomia:RpcDatasetRequestMessage",
