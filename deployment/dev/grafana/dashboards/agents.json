{
  "uid": "ds-protocol-agents",
  "title": "DS Protocol \u00b7 Agents",
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "ds-protocol"
  ],
  "templating": {
    "list": [
      {
        "name": "participant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(target_info, participant)",
          "refId": "participant"
        },
        "definition": "label_values(target_info, participant)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(span_calls_total{service_name!=\"compose\"}, service_name)",
          "refId": "service"
        },
        "definition": "label_values(span_calls_total{service_name!=\"compose\"}, service_name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Span rate by operation",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (span_name) (rate(span_calls_total{service_name=~\"$service\", participant=~\"$participant\", span_kind!=\"SPAN_KIND_CLIENT\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Span errors by operation",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (span_name) (rate(span_calls_total{service_name=~\"$service\", participant=~\"$participant\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Span p95 latency by operation",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(span_duration_milliseconds_bucket{service_name=~\"$service\", participant=~\"$participant\", span_kind!=\"SPAN_KIND_CLIENT\"}[$__rate_interval])))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Outbound HTTP rate (ymir client)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server_address, http_response_status_code) (rate(http_client_request_duration_seconds_count{participant=~\"$participant\"}[$__rate_interval]))",
          "legendFormat": "{{server_address}} {{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Outbound HTTP p95 (ymir client)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, server_address) (rate(http_client_request_duration_seconds_bucket{participant=~\"$participant\"}[$__rate_interval])))",
          "legendFormat": "{{server_address}}"
        }
      ]
    }
  ]
}