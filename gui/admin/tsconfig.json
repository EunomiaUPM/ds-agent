{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    //    "strictNullChecks": true,
    //    "noUnusedLocals": false,
    //    "noUnusedParameters": false,
    //    "noFallthroughCasesInSwitch": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src", "../shared/src/types.d.ts"],
  // Pages of the former built-in OAuth module, out of the route tree (kept as they were).
  "exclude": ["src/routes/-oauth", "src/routes/-login"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
