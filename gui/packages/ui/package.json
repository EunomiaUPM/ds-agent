{
  "name": "@eunomia/ui",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "tailwind-preset.cjs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./json": {
      "types": "./dist/json/index.d.ts",
      "import": "./dist/json/index.js"
    },
    "./wallet": {
      "types": "./dist/wallet/index.d.ts",
      "import": "./dist/wallet/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./tailwind-preset": "./tailwind-preset.cjs"
  },
  "scripts": {
    "build": "tsup && cp src/tokens.css src/styles.css dist/",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@monaco-editor/react": ">=4.6.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-router": "^1.105.0",
    "monaco-editor": ">=0.45.0 <1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@monaco-editor/react": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.13",
    "lucide-react": "^0.453.0",
    "motion": "^12.0.0 || ^13.0.0",
    "react-hook-form": "^7.56.4",
    "react-syntax-highlighter": "^15.6.6",
    "recharts": "^3.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.0.2"
  }
}
