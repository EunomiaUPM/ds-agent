{
  "id": "credential-claim",
  "version": "1.0",
  "kind": "constraint",
  "controlPoints": [
    "negotiation"
  ],
  "title": "Credential claim",
  "description": "A claim of one of the peer's credentials, read with a JSONPath, compared with a value.",
  "author": "Eunomia connector",
  "visibility": "Public",
  "content": {
    "ovc:credentialSubjectType": "$type",
    "ovc:leftOperand": "$path",
    "operator": "$operator",
    "rightOperand": "$value"
  },
  "parameters": {
    "$type": {
      "dataType": "iri",
      "defaultValue": "gx:LegalParticipant",
      "ui": {
        "label": "Credential type"
      }
    },
    "$path": {
      "dataType": "string",
      "restrictions": {
        "regex": "^\\$\\.credentialSubject(\\.[^.\\s]+)+$"
      },
      "ui": {
        "label": "Claim path",
        "placeholder": "$.credentialSubject.gx:legalAddress.gx:countrySubdivisionCode"
      }
    },
    "$operator": {
      "dataType": "selection",
      "defaultValue": "eq",
      "restrictions": {
        "values": [
          "eq",
          "neq",
          "isAnyOf",
          "isNoneOf",
          "gt",
          "gteq",
          "lt",
          "lteq"
        ]
      },
      "ui": {
        "label": "Operator"
      }
    },
    "$value": {
      "dataType": "list",
      "ui": {
        "label": "Values",
        "description": "One value for eq or neq; several for isAnyOf or isNoneOf."
      }
    }
  }
}
