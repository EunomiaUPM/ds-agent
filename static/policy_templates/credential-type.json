{
  "id": "credential-type",
  "version": "1.0",
  "kind": "constraint",
  "controlPoints": [
    "negotiation"
  ],
  "title": "Holds a credential",
  "description": "The peer presents a verifiable credential of the given type.",
  "author": "Eunomia connector",
  "visibility": "Public",
  "content": {
    "leftOperand": "ovc:credentialSubjectType",
    "operator": "eq",
    "rightOperand": "$type"
  },
  "parameters": {
    "$type": {
      "dataType": "iri",
      "defaultValue": "gx:LegalParticipant",
      "ui": {
        "label": "Credential type",
        "placeholder": "gx:LegalParticipant"
      }
    }
  }
}
