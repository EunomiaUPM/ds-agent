{
  "openapi": "3.1.0",
  "info": {
    "title": "Eunomia DS Catalog Protocol API",
    "description": "Catalog Protocol of the Dataspace Protocol 2025-1 as served by the catalog agent, plus the\nRPC endpoints that make this agent act as a consumer against a peer's catalog.\nProtocol endpoints authenticate the peer with the token it obtained through GNAP onboarding\nand answer as a read-only scope on the tenant that peer belongs to. Prefixed keys\n(`dspace:`, `dcat:`, ...) are normalised before parsing.\n",
    "version": "1.0.0",
    "license": {
      "name": "GPL-3.0-or-later",
      "url": "https://www.gnu.org/licenses/gpl-3.0.html"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:1200",
      "description": "Provider agent (dev)"
    },
    {
      "url": "http://127.0.0.1:1100",
      "description": "Consumer agent (dev)"
    }
  ],
  "tags": [
    {
      "name": "Catalog Protocol",
      "description": "DSP endpoints called by peers"
    },
    {
      "name": "Catalog RPC",
      "description": "Requests this agent sends to a peer's catalog"
    }
  ],
  "paths": {
    "/dsp/current/catalog/request": {
      "post": {
        "tags": [
          "Catalog Protocol"
        ],
        "operationId": "protocolRequestCatalog",
        "summary": "Catalog request",
        "description": "Answers the tenant's catalog with the datasets and offers visible to the peer.",
        "security": [
          {
            "peerBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogRequestMessage"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DspCatalog"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ProtocolBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/PeerUnauthorized"
          }
        }
      }
    },
    "/dsp/current/catalog/datasets/{id}": {
      "get": {
        "tags": [
          "Catalog Protocol"
        ],
        "operationId": "protocolRequestDataset",
        "summary": "Dataset request",
        "security": [
          {
            "peerBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/UrnPathId"
          }
        ],
        "responses": {
          "200": {
            "description": "Dataset with its distributions and offers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DspDataset"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ProtocolBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/PeerUnauthorized"
          }
        }
      }
    },
    "/dsp/current/catalog/rpc/setup-catalog-request": {
      "post": {
        "tags": [
          "Catalog RPC"
        ],
        "operationId": "rpcSetupCatalogRequest",
        "summary": "Request a peer's catalog",
        "description": "Sends a catalog request to the peer and caches the answer unless `noCache` is set.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RpcCatalogRequestMessageDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request sent and the peer's catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcCatalogResponseMessageDto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/dsp/current/catalog/rpc/setup-dataset-request": {
      "post": {
        "tags": [
          "Catalog RPC"
        ],
        "operationId": "rpcSetupDatasetRequest",
        "summary": "Request one dataset from a peer",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RpcDatasetRequestMessageDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request sent and the peer's dataset",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcDatasetResponseMessageDto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "OAuth access token (JWT) or personal access token issued by `/oauth`."
      },
      "peerBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token the peer obtained from this agent through GNAP onboarding."
      }
    },
    "parameters": {
      "TenantHeader": {
        "name": "x-tenant-id",
        "in": "header",
        "required": false,
        "description": "Tenant to act on. Non-admins may only name their own tenant.",
        "schema": {
          "type": "string"
        }
      },
      "UrnPathId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "URN of the resource.",
        "schema": {
          "type": "string",
          "examples": [
            "urn:uuid:5b0f6a1e-2c3d-4e5f-8a9b-0c1d2e3f4a5b"
          ]
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed request or failed validation",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorInfo"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The caller may not act on this tenant or resource",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorInfo"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Unexpected server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorInfo"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorInfo"
            }
          }
        }
      },
      "PeerUnauthorized": {
        "description": "Missing or unknown peer token (empty body)"
      },
      "ProtocolBadRequest": {
        "description": "Invalid message or failed request, as plain text",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid bearer token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorInfo"
            }
          }
        }
      }
    },
    "schemas": {
      "CatalogRequestMessage": {
        "type": "object",
        "required": [
          "@context",
          "@type"
        ],
        "properties": {
          "@context": {
            "$ref": "#/components/schemas/ContextField"
          },
          "@type": {
            "type": "string",
            "const": "CatalogRequestMessage"
          },
          "filter": {
            "description": "Implementation-specific filter, any JSON value."
          }
        }
      },
      "ContextField": {
        "description": "JSON-LD context; must include the DSP 2024-1 or 2025-1 context.",
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ],
        "examples": [
          "https://w3id.org/dspace/2025/1/context.jsonld"
        ]
      },
      "DspCatalog": {
        "type": "object",
        "description": "DCAT catalog as sent over DSP.",
        "required": [
          "@context",
          "@type",
          "@id",
          "identifier",
          "issued",
          "catalog",
          "dataset",
          "service"
        ],
        "properties": {
          "@context": {
            "$ref": "#/components/schemas/ContextField"
          },
          "@type": {
            "type": "string",
            "examples": [
              "Catalog"
            ]
          },
          "@id": {
            "type": "string"
          },
          "homepage": {
            "type": "string"
          },
          "theme": {
            "type": "string"
          },
          "keyword": {
            "type": "string"
          },
          "conformsTo": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          },
          "issued": {
            "type": "string",
            "description": "Naive timestamp, no zone."
          },
          "modified": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "participantId": {
            "type": "string"
          },
          "hasPolicy": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OdrlOffer"
            }
          },
          "extraFields": {},
          "catalog": {
            "type": "array",
            "description": "Nested catalogs, full or minimized.",
            "items": {
              "type": "object"
            }
          },
          "dataset": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DspDataset"
            }
          },
          "service": {
            "description": "One data service, a minimized one, or a list.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/DspDataService"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/DspDataService"
                }
              }
            ]
          }
        }
      },
      "DspDataService": {
        "type": "object",
        "description": "Full data service, or a minimized one with only `@type`, `@id` and DCAT fields.",
        "required": [
          "@type",
          "@id",
          "endpointURL"
        ],
        "properties": {
          "@context": {
            "$ref": "#/components/schemas/ContextField"
          },
          "@type": {
            "type": "string",
            "examples": [
              "DataService"
            ]
          },
          "@id": {
            "type": "string"
          },
          "theme": {
            "type": "string"
          },
          "keyword": {
            "type": "string"
          },
          "endpointDescription": {
            "type": "string"
          },
          "endpointURL": {
            "type": "string"
          },
          "conformsTo": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          },
          "issued": {
            "type": "string"
          },
          "modified": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hasPolicy": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OdrlOffer"
            }
          },
          "extraFields": {}
        }
      },
      "DspDataset": {
        "type": "object",
        "required": [
          "@type",
          "@id",
          "identifier",
          "issued",
          "hasPolicy",
          "distribution"
        ],
        "properties": {
          "@context": {
            "$ref": "#/components/schemas/ContextField"
          },
          "@type": {
            "type": "string",
            "examples": [
              "Dataset"
            ]
          },
          "@id": {
            "type": "string"
          },
          "theme": {
            "type": "string"
          },
          "keyword": {
            "type": "string"
          },
          "conformsTo": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          },
          "issued": {
            "type": "string",
            "description": "Naive timestamp, no zone."
          },
          "modified": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hasPolicy": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OdrlOffer"
            }
          },
          "extraFields": {},
          "distribution": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DspDistribution"
            }
          }
        }
      },
      "DspDistribution": {
        "type": "object",
        "required": [
          "@type",
          "@id",
          "issued",
          "formats"
        ],
        "properties": {
          "@context": {
            "$ref": "#/components/schemas/ContextField"
          },
          "@type": {
            "type": "string",
            "examples": [
              "Distribution"
            ]
          },
          "@id": {
            "type": "string"
          },
          "accessService": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DspDataService"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/DspDataService"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "issued": {
            "type": "string",
            "description": "Naive timestamp, no zone."
          },
          "modified": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "formats": {
            "type": "string",
            "examples": [
              "HttpData-PULL"
            ]
          },
          "hasPolicy": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OdrlOffer"
            }
          },
          "extraFields": {}
        }
      },
      "ErrorInfo": {
        "type": "object",
        "description": "Error body returned by every agent.",
        "required": [
          "message",
          "error_code"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "error_code": {
            "type": "integer",
            "description": "Internal error code of the failure kind."
          },
          "details": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "OdrlAtomicConstraint": {
        "type": "object",
        "required": [
          "leftOperand",
          "operator",
          "rightOperand"
        ],
        "properties": {
          "leftOperand": {
            "type": "string"
          },
          "operator": {
            "$ref": "#/components/schemas/OdrlOperator"
          },
          "rightOperand": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              },
              {
                "type": "array",
                "items": {}
              }
            ]
          }
        }
      },
      "OdrlConstraint": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/OdrlAtomicConstraint"
          },
          {
            "$ref": "#/components/schemas/OdrlLogicalConstraint"
          }
        ]
      },
      "OdrlDuty": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "constraint": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/OdrlConstraint"
            }
          }
        }
      },
      "OdrlLogicalConstraint": {
        "type": "object",
        "properties": {
          "and": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OdrlConstraint"
            }
          },
          "andSequence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OdrlConstraint"
            }
          },
          "or": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OdrlConstraint"
            }
          },
          "xone": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OdrlConstraint"
            }
          }
        }
      },
      "OdrlOffer": {
        "type": "object",
        "required": [
          "@id",
          "@type"
        ],
        "properties": {
          "@id": {
            "type": "string"
          },
          "@type": {
            "type": "string",
            "enum": [
              "Offer",
              "Agreement"
            ]
          },
          "profile": {
            "$ref": "#/components/schemas/OdrlProfile"
          },
          "permission": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OdrlPermission"
            }
          },
          "obligation": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OdrlDuty"
            }
          },
          "prohibition": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OdrlDuty"
            }
          },
          "target": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "OdrlOperator": {
        "type": "string",
        "enum": [
          "eq",
          "gt",
          "gteq",
          "lteq",
          "hasPart",
          "isA",
          "isAllOf",
          "isAnyOf",
          "isNoneOf",
          "isPartOf",
          "lt",
          "termLteq",
          "neq"
        ]
      },
      "OdrlPermission": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "examples": [
              "use"
            ]
          },
          "constraint": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OdrlConstraint"
            }
          },
          "duty": {
            "$ref": "#/components/schemas/OdrlDuty"
          }
        }
      },
      "OdrlProfile": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      },
      "RpcCatalogRequestMessageDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "associatedAgentPeer",
          "filter"
        ],
        "properties": {
          "associatedAgentPeer": {
            "type": "string",
            "description": "Participant id (DID) of the peer."
          },
          "filter": {
            "description": "Filter forwarded in the catalog request, any JSON value."
          },
          "noCache": {
            "type": "boolean",
            "default": false,
            "description": "Skip storing the answer in the peer catalog cache."
          }
        }
      },
      "RpcCatalogResponseMessageDto": {
        "type": "object",
        "required": [
          "request",
          "response"
        ],
        "properties": {
          "request": {
            "$ref": "#/components/schemas/RpcCatalogRequestMessageDto"
          },
          "response": {
            "$ref": "#/components/schemas/DspCatalog"
          }
        }
      },
      "RpcDatasetRequestMessageDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "associatedAgentPeer",
          "dataset"
        ],
        "properties": {
          "associatedAgentPeer": {
            "type": "string",
            "description": "Participant id (DID) of the peer."
          },
          "dataset": {
            "type": "string",
            "description": "URN of the dataset."
          },
          "noCache": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      },
      "RpcDatasetResponseMessageDto": {
        "type": "object",
        "required": [
          "request",
          "response"
        ],
        "properties": {
          "request": {
            "$ref": "#/components/schemas/RpcDatasetRequestMessageDto"
          },
          "response": {
            "$ref": "#/components/schemas/DspDataset"
          }
        }
      }
    }
  }
}
