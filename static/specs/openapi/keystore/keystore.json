{
  "openapi": "3.1.0",
  "info": {
    "title": "Eunomia DS Keystore API",
    "description": "Tenant-scoped parameters and secrets with optimistic versioning (`crates/keystore`).\nKeys are path-like (`/connectors/http/token`): they start with `/`, have no empty segments\nand only use `a-z A-Z 0-9 _ - .`. In the URL the leading `/` is dropped, so\n`/api/v1/keystore/secrets/connectors/http/token` addresses `/connectors/http/token`.\nSecret values are write-only: every response shows them as `*****`.\n",
    "version": "1.0.0",
    "license": {
      "name": "GPL-3.0-or-later",
      "url": "https://www.gnu.org/licenses/gpl-3.0.html"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:1200",
      "description": "Provider agent (dev)"
    },
    {
      "url": "http://127.0.0.1:1100",
      "description": "Consumer agent (dev)"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Keystore Parameters",
      "description": "Plain configuration values"
    },
    {
      "name": "Keystore Secrets",
      "description": "Write-only secret values"
    },
    {
      "name": "Keystore Config",
      "description": "Effective application configuration"
    }
  ],
  "paths": {
    "/api/v1/keystore/parameters": {
      "get": {
        "tags": [
          "Keystore Parameters"
        ],
        "operationId": "listParameters",
        "summary": "List parameters",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantHeader"
          },
          {
            "$ref": "#/components/parameters/KeyPrefix"
          },
          {
            "$ref": "#/components/parameters/TenantIdQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "Parameters under the prefix",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/KeystoreParameterView"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Keystore Parameters"
        ],
        "operationId": "createParameter",
        "summary": "Create a parameter",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KeystoreNewParameterCommand"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Parameter created at version 1",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeystoreParameterView"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/v1/keystore/parameters/{key}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/KeyPath"
        },
        {
          "$ref": "#/components/parameters/TenantHeader"
        }
      ],
      "get": {
        "tags": [
          "Keystore Parameters"
        ],
        "operationId": "getParameter",
        "summary": "Read a parameter",
        "responses": {
          "200": {
            "description": "Parameter with its value",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeystoreParameterView"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "put": {
        "tags": [
          "Keystore Parameters"
        ],
        "operationId": "updateParameter",
        "summary": "Update a parameter",
        "description": "Rejected with 409 unless `expectedVersion` is the current version.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KeystoreEditParameterCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Version left by the update",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeystoreVersionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "Keystore Parameters"
        ],
        "operationId": "deleteParameter",
        "summary": "Delete a parameter",
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/v1/keystore/secrets": {
      "get": {
        "tags": [
          "Keystore Secrets"
        ],
        "operationId": "listSecrets",
        "summary": "List secrets",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantHeader"
          },
          {
            "$ref": "#/components/parameters/KeyPrefix"
          },
          {
            "$ref": "#/components/parameters/TenantIdQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "Secrets under the prefix, values masked",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/KeystoreSecretView"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Keystore Secrets"
        ],
        "operationId": "createSecret",
        "summary": "Create a secret",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KeystoreNewSecretCommand"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Secret created at version 1, value masked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeystoreSecretView"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/v1/keystore/secrets/{key}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/KeyPath"
        },
        {
          "$ref": "#/components/parameters/TenantHeader"
        }
      ],
      "get": {
        "tags": [
          "Keystore Secrets"
        ],
        "operationId": "getSecret",
        "summary": "Read a secret's metadata",
        "responses": {
          "200": {
            "description": "Secret, value masked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeystoreSecretView"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "put": {
        "tags": [
          "Keystore Secrets"
        ],
        "operationId": "updateSecret",
        "summary": "Replace a secret's value",
        "description": "Rejected with 409 unless `expectedVersion` is the current version.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KeystoreEditSecretCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Version left by the update",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeystoreVersionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "Keystore Secrets"
        ],
        "operationId": "deleteSecret",
        "summary": "Delete a secret",
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/v1/keystore/config": {
      "get": {
        "tags": [
          "Keystore Config"
        ],
        "operationId": "getApplicationConfig",
        "summary": "Effective application configuration",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "Config file of the process, one optional section per agent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeystoreApplicationConfig"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "OAuth access token (JWT) or personal access token issued by `/oauth`."
      }
    },
    "parameters": {
      "KeyPath": {
        "name": "key",
        "in": "path",
        "required": true,
        "description": "Entry key without its leading `/`; may contain further `/` segments.",
        "schema": {
          "type": "string",
          "examples": [
            "connectors/http/token"
          ]
        }
      },
      "KeyPrefix": {
        "name": "prefix",
        "in": "query",
        "required": false,
        "description": "Only entries whose key starts with this prefix.",
        "schema": {
          "type": "string",
          "examples": [
            "/connectors"
          ]
        }
      },
      "TenantHeader": {
        "name": "x-tenant-id",
        "in": "header",
        "required": false,
        "description": "Tenant to act on. Non-admins may only name their own tenant.",
        "schema": {
          "type": "string"
        }
      },
      "TenantIdQuery": {
        "name": "tenant_id",
        "in": "query",
        "required": false,
        "description": "Tenant filter, honoured for admins.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed request or failed validation",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorInfo"
            }
          }
        }
      },
      "Conflict": {
        "description": "The resource already exists or changed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorInfo"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The caller may not act on this tenant or resource",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorInfo"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Unexpected server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorInfo"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorInfo"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid bearer token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorInfo"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorInfo": {
        "type": "object",
        "description": "Error body returned by every agent.",
        "required": [
          "message",
          "error_code"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "error_code": {
            "type": "integer",
            "description": "Internal error code of the failure kind."
          },
          "details": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "KeystoreApplicationConfig": {
        "type": "object",
        "description": "One optional section per agent, as loaded from the config file.",
        "properties": {
          "monolith": {
            "type": [
              "object",
              "null"
            ]
          },
          "transfer": {
            "type": [
              "object",
              "null"
            ]
          },
          "contracts": {
            "type": [
              "object",
              "null"
            ]
          },
          "catalog": {
            "type": [
              "object",
              "null"
            ]
          },
          "ssi_auth": {
            "type": [
              "object",
              "null"
            ]
          },
          "gateway": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "KeystoreEditParameterCommand": {
        "type": "object",
        "required": [
          "value",
          "expectedVersion"
        ],
        "properties": {
          "value": {
            "description": "Any JSON value."
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "KeystoreEditSecretCommand": {
        "type": "object",
        "required": [
          "value",
          "expectedVersion"
        ],
        "properties": {
          "value": {
            "description": "New secret content, any JSON value."
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "KeystoreNewParameterCommand": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^(/[A-Za-z0-9_.-]+)+$",
            "examples": [
              "/connectors/http/base-url"
            ]
          },
          "value": {
            "description": "Any JSON value."
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "tenant_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Target tenant, honoured for admins."
          }
        }
      },
      "KeystoreNewSecretCommand": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^(/[A-Za-z0-9_.-]+)+$",
            "examples": [
              "/connectors/http/token"
            ]
          },
          "value": {
            "description": "Secret content, any JSON value."
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "tenant_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Target tenant, honoured for admins."
          }
        }
      },
      "KeystoreParameterView": {
        "type": "object",
        "required": [
          "key",
          "version",
          "value",
          "createdAt",
          "updatedAt",
          "createdBy",
          "updatedBy"
        ],
        "properties": {
          "key": {
            "type": "string",
            "examples": [
              "/connectors/http/base-url"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "value": {
            "description": "Any JSON value."
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": "string"
          },
          "updatedBy": {
            "type": "string"
          }
        }
      },
      "KeystoreSecretView": {
        "type": "object",
        "required": [
          "key",
          "version",
          "value",
          "createdAt",
          "updatedAt",
          "createdBy",
          "updatedBy"
        ],
        "properties": {
          "key": {
            "type": "string",
            "examples": [
              "/connectors/http/token"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "value": {
            "type": "string",
            "const": "*****",
            "description": "Always masked."
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": "string"
          },
          "updatedBy": {
            "type": "string"
          }
        }
      },
      "KeystoreVersionResponse": {
        "type": "object",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  }
}
