    "/dataplane/proxy/{dataPlaneId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProxyDataPlaneId"
        }
      ],
      "get": {
        "tags": [
          "Dataplane Proxy"
        ],
        "operationId": "proxyDataplaneGet",
        "summary": "Forward a request to the transfer's back end",
        "description": "Any method is forwarded to the upstream of the process egress config, with the\nconnector credentials resolved from the keystore. Bodies over 2 MiB are rejected, and\nthe upstream must answer within 30 s. Not behind OAuth: only STARTED processes answer.\n",
        "security": [],
        "responses": {
          "200": {
            "description": "Upstream response, relayed as is (any status)"
          },
          "400": {
            "description": "Id is not a URN, or body too large (plain text)",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Transfer is not STARTED (plain text)",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Unknown dataplane process (plain text)",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Lookup failed or egress not proxyable (plain text)",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
