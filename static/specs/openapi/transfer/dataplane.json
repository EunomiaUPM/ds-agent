{
  "openapi": "3.1.0",
  "info": {
    "title": "Eunomia DS Dataplane API",
    "description": "Dataplane hosted by the transfer agent (`crates/dataplane`): the dataplane process of each\ntransfer with its state transitions and diagnostic events, and the HTTP proxy that serves\npull transfers. Log and event records use snake_case keys.\n",
    "version": "1.0.0",
    "license": {
      "name": "GPL-3.0-or-later",
      "url": "https://www.gnu.org/licenses/gpl-3.0.html"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:1200",
      "description": "Provider agent (dev)"
    },
    {
      "url": "http://127.0.0.1:1100",
      "description": "Consumer agent (dev)"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Dataplane Processes",
      "description": "Dataplane side of each transfer"
    },
    {
      "name": "Dataplane Events",
      "description": "Diagnostic events of dataplane processes"
    },
    {
      "name": "Dataplane Proxy",
      "description": "HTTP data proxy for pull transfers"
    }
  ],
  "paths": {
    "/api/v1/transfer-agent/dataplane/dataplane-processes": {
      "get": {
        "tags": [
          "Dataplane Processes"
        ],
        "operationId": "getDataplaneTransfers",
        "summary": "List dataplane processes",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantHeader"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/PageNumber"
          },
          {
            "$ref": "#/components/parameters/Sort"
          },
          {
            "$ref": "#/components/parameters/TenantIdQuery"
          },
          {
            "name": "transfer_process_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "role",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/DataplaneRole"
            }
          },
          {
            "name": "interaction_mode",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/InteractionMode"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/DataplaneState"
            }
          },
          {
            "$ref": "#/components/parameters/CreatedAfter"
          },
          {
            "$ref": "#/components/parameters/CreatedBefore"
          }
        ],
        "responses": {
          "200": {
            "description": "Page of dataplane processes",
            "headers": {
              "X-Total-Count": {
                "$ref": "#/components/headers/XTotalCount"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedDataplaneTransferDto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "tags": [
          "Dataplane Processes"
        ],
        "operationId": "createDataplaneTransfer",
        "summary": "Create a dataplane process record",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewDataplaneTransferDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created dataplane process",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataplaneTransferDto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
