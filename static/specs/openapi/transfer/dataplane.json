  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "OAuth access token (JWT) or personal access token issued by `/oauth`."
      }
    },
    "headers": {
      "XTotalCount": {
        "description": "Total number of matching items.",
        "schema": {
          "type": "integer"
        }
      }
    },
    "parameters": {
      "CreatedAfter": {
        "name": "created_after",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "CreatedBefore": {
        "name": "created_before",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "Opaque `nextCursor` of the previous page.",
        "schema": {
          "type": "string"
        }
      },
      "DataplaneProcessId": {
        "name": "dataplaneProcessId",
        "in": "path",
        "required": true,
        "description": "URN of the dataplane process.",
        "schema": {
          "type": "string"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Page size, clamped to 1..=100.",
        "schema": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 100
        }
      },
      "PageNumber": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "1-based page index for offset paging, used when no cursor is sent.",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "ProxyDataPlaneId": {
        "name": "dataPlaneId",
        "in": "path",
        "required": true,
        "description": "URN of a STARTED dataplane process.",
        "schema": {
          "type": "string"
        }
      },
      "Sort": {
        "name": "sort",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "created_at_asc",
            "created_at_desc",
            "updated_at_asc",
            "updated_at_desc"
          ],
          "default": "created_at_desc"
        }
      },
      "TenantHeader": {
        "name": "x-tenant-id",
        "in": "header",
        "required": false,
        "description": "Tenant to act on. Non-admins may only name their own tenant.",
        "schema": {
          "type": "string"
        }
      },
      "TenantIdQuery": {
        "name": "tenant_id",
        "in": "query",
        "required": false,
        "description": "Tenant filter, honoured for admins.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed request or failed validation",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorInfo"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The caller may not act on this tenant or resource",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorInfo"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorInfo"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid bearer token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorInfo"
            }
          }
        }
      }
    },
    "schemas": {
      "BatchRequests": {
        "type": "object",
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "description": "URNs to look up.",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DataplaneInfoResponse": {
        "type": "object",
        "required": [
          "id",
          "interaction_mode"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "interaction_mode": {
            "type": "string",
            "examples": [
              "Pull"
            ]
          },
          "ingress_url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DataplaneRole": {
        "type": "string",
        "enum": [
          "Provider",
          "Consumer"
        ]
      },
      "DataplaneState": {
        "type": "string",
        "enum": [
          "Init",
          "Configuring",
          "Auth",
          "Ready",
          "Subscribing",
          "Started",
          "Unsubscribing",
          "Stopped",
          "Terminated",
          "Error"
        ]
      },
      "DataplaneTransferDto": {
        "type": "object",
        "required": [
          "id",
          "tenantId",
          "transferProcessId",
          "role",
          "interactionMode",
          "state",
          "ingressConfig",
          "egressConfig",
          "createdAt",
          "fields",
          "logs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "URN of the dataplane process."
          },
          "tenantId": {
            "type": "string"
          },
          "transferProcessId": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/DataplaneRole"
          },
          "interactionMode": {
            "$ref": "#/components/schemas/InteractionMode"
          },
          "state": {
            "$ref": "#/components/schemas/DataplaneState"
          },
          "connectorInstanceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "ingressConfig": {
            "description": "Where data enters the dataplane, any JSON value."
          },
          "egressConfig": {
            "description": "Where data leaves the dataplane, any JSON value."
          },
          "flowControl": {
            "description": "Flow control settings, any JSON value."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "fields": {
            "type": "object",
            "description": "Extra key/value fields of the process.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "logs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DataplaneTransferLogDto"
            }
          }
        }
      },
      "DataplaneTransferLogDto": {
        "type": "object",
        "required": [
          "id",
          "tenant_id",
          "dataplane_process_id",
          "new_state",
          "trigger",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "dataplane_process_id": {
            "type": "string"
          },
          "previous_state": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DataplaneState"
              },
              {
                "type": "null"
              }
            ]
          },
          "new_state": {
            "$ref": "#/components/schemas/DataplaneState"
          },
          "trigger": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EditDataplaneTransferDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DataplaneState"
              },
              {
                "type": "null"
              }
            ]
          },
          "connectorInstanceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "ingressConfig": {},
          "egressConfig": {},
          "flowControl": {},
          "fields": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "ErrorInfo": {
        "type": "object",
        "description": "Error body returned by every agent.",
        "required": [
          "message",
          "error_code"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "error_code": {
            "type": "integer",
            "description": "Internal error code of the failure kind."
          },
          "details": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "InteractionMode": {
        "type": "string",
        "enum": [
          "Pull",
          "Push"
        ]
      },
      "LogLevel": {
        "type": "string",
        "enum": [
          "Debug",
          "Info",
          "Warn",
          "Error"
        ]
      },
      "NewDataplaneTransferDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenantId",
          "transferProcessId",
          "role",
          "interactionMode",
          "state",
          "ingressConfig",
          "egressConfig"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ],
            "description": "URN; generated when absent."
          },
          "tenantId": {
            "type": "string"
          },
          "transferProcessId": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/DataplaneRole"
          },
          "interactionMode": {
            "$ref": "#/components/schemas/InteractionMode"
          },
          "state": {
            "$ref": "#/components/schemas/DataplaneState"
          },
          "connectorInstanceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "ingressConfig": {},
          "egressConfig": {}
        }
      },
      "PaginatedDataplaneTransferDto": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DataplaneTransferDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "Absent on the last page."
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "TransferEventDto": {
        "type": "object",
        "required": [
          "id",
          "tenant_id",
          "transfer_id",
          "level",
          "component",
          "message",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "transfer_id": {
            "type": "string",
            "description": "URN of the dataplane process."
          },
          "level": {
            "$ref": "#/components/schemas/LogLevel"
          },
          "component": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "description": "Extra data, any JSON value."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
