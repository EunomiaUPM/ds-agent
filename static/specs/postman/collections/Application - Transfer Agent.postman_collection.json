{
	"info": {
		"_postman_id": "ea121a3b-eeec-4ecf-8cc5-cdf6d6716244",
		"name": "Application - Transfer Agent",
		"description": "Transfer agent: eunomia RPC on both sides, the management API (processes, messages, dataplane) and the DSP endpoints.\n\nSet `TransferProvider` and `TransferConsumer` in the environment and `providerDid`, `consumerDid` and `agreementId` (a finalized agreement) here. RPC continuations take `@id`, each agent's own process id, captured by the tests.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "RPC",
			"item": [
				{
					"name": "Request (consumer)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{TransferConsumer}}/dsp/current/transfers/rpc/setup-request",
							"host": [
								"{{TransferConsumer}}"
							],
							"path": [
								"dsp",
								"current",
								"transfers",
								"rpc",
								"setup-request"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"@context\": \"https://w3id.org/eunomia/v1/context.jsonld\",\n    \"@type\": \"RpcTransferRequestMessage\",\n    \"associatedAgentPeer\": \"{{providerDid}}\",\n    \"providerAddress\": \"{{TransferProvider}}/dsp/current\",\n    \"callbackAddress\": \"{{TransferConsumer}}/dsp/current\",\n    \"agreementId\": \"{{agreementId}}\",\n    \"format\": \"http+pull\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"answers 200 or 201\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
									"const body = pm.response.json();",
									"pm.test(\"answers the process as it stands\", () => pm.expect(body.transferAgentModel).to.exist);",
									"pm.collectionVariables.set(\"consumerProcessId\", body.transferAgentModel.id);",
									"pm.collectionVariables.set(\"consumerPid\", body.transferAgentModel.correlation.consumerPid);",
									"pm.collectionVariables.set(\"providerPid\", body.transferAgentModel.correlation.providerPid);"
								]
							}
						}
					]
				},
				{
					"name": "Find provider process",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{TransferProvider}}/api/v1/transfer-agent/transfer-processes?limit=100",
							"host": [
								"{{TransferProvider}}"
							],
							"path": [
								"api",
								"v1",
								"transfer-agent",
								"transfer-processes"
							],
							"query": [
								{
									"key": "limit",
									"value": "100"
								}
							]
						},
						"description": "The provider's own id of the transfer; RPC calls never take DSP pids."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"answers 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
									"const items = pm.response.json().items;",
									"const process = items.find(p => p.correlation.providerPid === pm.collectionVariables.get(\"providerPid\"));",
									"pm.test(\"finds the process\", () => pm.expect(process, \"no process with that providerPid\").to.exist);",
									"pm.collectionVariables.set(\"providerProcessId\", process.id);"
								]
							}
						}
					]
				},
